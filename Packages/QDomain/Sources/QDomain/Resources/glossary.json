      {
        "id": "ezafe",
        "title": "Ezafe - Word Glue",
        "note": "The ezafe is a short -e sound that glues a noun to whatever describes or owns it: کتابِ من (ketāb-e man, \"my book\", literally \"book-of me\"). Everyday Persian doesn't write it — you have to hear it — so the lessons mark it for you: a kasra (ِ) on the word it follows, or a small hamza (ٔ) on a silent ه. Turn on \"Show vowel marks and the ezafe\" in a lesson's settings to see the marks; hovering a word that carries one highlights it either way. After a vowel it becomes -ye, carried by a ی. It links a whole chain, one word at a time — but never a noun to its verb: کتاب خوب است (the book is good) has none, while کتابِ خوب (a good book) does.",
        "terms": [
          {
            "term": "کتابِ من",
            "romanization": "ketāb-e man",
            "definition": "my book — after a consonant: -e, marked with a kasra"
          },
          {
            "term": "هوایِ خوب",
            "romanization": "havā-ye khūb",
            "definition": "good weather — after ا or و: -ye, and a ی is written to carry it"
          },
          {
            "term": "خانهٔ من",
            "romanization": "khāne-ye man",
            "definition": "my house — after a silent ه: -ye, marked with a small hamza (or written خانه‌ی)"
          },
          {
            "term": "صندلیِ چوبی",
            "romanization": "sandalī-ye chūbī",
            "definition": "a wooden chair — after ی: -ye, marked with a kasra on the ی"
          },
          {
            "term": "کیفِ مادرم",
            "romanization": "kīf-e mādaram",
            "definition": "my mother's bag — possession: the owner comes after"
          },
          {
            "term": "پیراهنِ زرشکی",
            "romanization": "pīrāhan-e zereshkī",
            "definition": "a maroon shirt — an adjective comes after its noun"
          },
          {
            "term": "کتابِ قرمزِ علی",
            "romanization": "ketāb-e ghermez-e Alī",
            "definition": "Ali's red book — a chain: every link but the last takes it"
          },
          {
            "term": "نزدیکِ مدرسه",
            "romanization": "nazdīk-e madrese",
            "definition": "near the school — many prepositions take it too"
          },
          {
            "term": "آقایِ رضایی",
            "romanization": "āghā-ye Rezāyī",
            "definition": "Mr. Rezaei — titles before a name"
          },
          {
            "term": "کتاب خوب است",
            "romanization": "ketāb khūb ast",
            "definition": "the book is good — no ezafe before a verb (compare ketāb-e khūb, a good book)"
          }
        ]
